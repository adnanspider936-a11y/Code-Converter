# UI buttons used during RUNNING and PAUSED states
pause_button = Button(SCREEN_WIDTH - 80, 20, 60, 30, "||", GRAY, toggle_pause, 24)

while running:
    # Event Handling
    clicked_buttons = []
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if GAME_STATE == 'HOME':
            clicked_buttons.extend(draw_home_screen())
        elif GAME_STATE == 'DEATH':
            clicked_buttons.extend(draw_death_screen())
        elif GAME_STATE == 'SHOP':
            clicked_buttons.extend(draw_shop_menu())
        elif GAME_STATE == 'ABILITIES':
            clicked_buttons.extend(draw_abilities_menu())
        elif GAME_STATE == 'INFO':
            clicked_buttons.extend(draw_info_box())
        elif GAME_STATE == 'RUNNING' or GAME_STATE == 'PAUSED':
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    toggle_pause()
            
            # Handle RUNNING/PAUSED buttons
            clicked_buttons.append(pause_button)
            
            if GAME_STATE == 'PAUSED':
                                pause_buttons = draw_pause_menu()
                clicked_buttons.extend(pause_buttons)

        # Check all relevant buttons for clicks
        for btn in clicked_buttons:
            btn.check_click(event)

        # Player Controls (Only available when RUNNING)
        if GAME_STATE == 'RUNNING' and event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE or event.key == pygame.K_UP:
                player.jump()
            elif event.key == pygame.K_LEFT:
                player.move_lane(-1)
            elif event.key == pygame.K_RIGHT:
                player.move_lane(1)

        # Spawning events (Only trigger when RUNNING)
        if GAME_STATE == 'RUNNING':
            if event.type == OBSTACLE_TIMER:
                random_lane_index = random.choice([0, 1, 2])
                new_obstacle = Obstacle(random_lane_index)
                all_sprites.add(new_obstacle); obstacles.add(new_obstacle)

            if event.type == COIN_TIMER:
                if not any(c.rect.left < SCREEN_WIDTH // 2 for c in coins):
                    random_lane_index = random.choice([0, 1, 2])
                    new_coin = Coin(random_lane_index)
                    all_sprites.add(new_coin); coins.add(new_coin)
                set_coin_timer_with_rate() 

            if event.type == DIAMOND_TIMER:
                if not any(d.rect.left < SCREEN_WIDTH // 2 for d in diamonds_group):
                    random_lane_index = random.choice([0, 1, 2])
                    new_diamond = Diamond(random_lane_index)
                    all_sprites.add(new_diamond); diamonds_group.add(new_diamond)

            if event.type == HOVERBOARD_TIMER:
                 if not any(h.rect.left < SCREEN_WIDTH // 2 for h in hoverboards):
                    random_lane_index = random.choice([0, 1, 2])
                    new_hoverboard = Hoverboard(random_lane_index)
                    all_sprites.add(new_hoverboard); hoverboards.add(new_hoverboard)


    # --- Game Logic Update (Only runs when RUNNING) ---
    if GAME_STATE == 'RUNNING':
        all_sprites.update()
        score += 1 

        # Hoverboard Timer Logic
        if hoverboard_active:
            hoverboard_timer -= 1
            if hoverboard_timer <= 0:
                hoverboard_active = False

        # Collectibles Check
        coins_collected = pygame.sprite.spritecollide(player, coins, True); 
        for coin in coins_collected: score += 100 

        diamonds_collected = pygame.sprite.spritecollide(player, diamonds_group, True); 
        for diamond in diamonds_collected: diamonds += 1
            
        hoverboards_collected = pygame.sprite.spritecollide(player, hoverboards, True);
        if hoverboards_collected:
            hoverboard_active = True; hoverboard_timer = HOVERBOARD_DURATION; player.is_jumping = False 

        # Collision Check (Obstacles)
        if pygame.sprite.spritecollide(player, obstacles, False):
            for obstacle in pygame.sprite.spritecollide(player, obstacles, False):
                if not hoverboard_active:
                    if player.rect.bottom > obstacle.rect.top + 5: 
                        set_state('DEATH') # Change state on death

    # --- Drawing/Rendering ---
    if GAME_STATE == 'RUNNING' or GAME_STATE == 'PAUSED':
        SCREEN.fill(WHITE)
        ground_y = player.ground_y + 40
        pygame.draw.line(SCREEN, BLACK, (LANE_X_POSITIONS[0] - LANE_WIDTH/2, ground_y), 
                                        (LANE_X_POSITIONS[-1] + LANE_WIDTH/2, ground_y), 5)
        
        all_sprites.draw(SCREEN)

        # Draw UI
        pause_button.draw(SCREEN)
        draw_text(f"SCORE: {score // 10}", FONT_MEDIUM, BLACK, SCREEN_WIDTH - 150, 30)
        draw_text(f"Coins: {score // 10}", FONT_SMALL, YELLOW, 80, 30)
        draw_text(f"Diamonds: {diamonds}", FONT_SMALL, PURPLE, 80, 60)
        
        if hoverboard_active:
            draw_text(f"HOVERBOARD: {hoverboard_timer // 60 + 1}s", FONT_SMALL, CYAN, SCREEN_WIDTH - 150, 60)

        # Draw pause overlay
        if GAME_STATE == 'PAUSED':
            draw_pause_menu()

    # Draw specific screens (overlays the running game view if necessary)
    elif GAME_STATE == 'HOME':
        draw_home_screen()
    elif GAME_STATE == 'DEATH':
        draw_death_screen()
    elif GAME_STATE == 'SHOP':
        draw_shop_menu()
    elif GAME_STATE == 'ABILITIES':
        draw_abilities_menu()
    elif GAME_STATE == 'INFO':
        draw_info_box()

    # Update the display
    pygame.display.flip()
    clock.tick(60)

# Quit Pygame and Python
pygame.quit()
sys.exit()
