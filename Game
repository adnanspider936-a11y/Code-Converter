# All sprite classes (Player, Obstacle, Coin, Diamond, Hoverboard) remain conceptually the same
# as the previous combined version, relying on global skin and state variables.

class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface([40, 40])
        self.image.fill(SKIN_COLORS[current_skin]) 
        self.rect = self.image.get_rect()
        self.current_lane_index = 1
        self.rect.centerx = LANE_X_POSITIONS[self.current_lane_index]
        self.ground_y = SCREEN_HEIGHT - 90 
        self.rect.y = self.ground_y 
        self.vertical_speed = 0
        self.is_jumping = False
        self.gravity = 1
        self.JUMP_STRENGTH = -20

    def update(self):
        if hoverboard_active:
            self.image.fill(CYAN)
            self.rect.height = 20 
            self.rect.y = self.ground_y + 20 
        else:
            self.image.fill(SKIN_COLORS[current_skin])
            self.rect.height = 40 
            if self.is_jumping or self.rect.y < self.ground_y:
                self.vertical_speed += self.gravity
            self.rect.y += self.vertical_speed
            if self.rect.y >= self.ground_y:
                self.rect.y = self.ground_y
                self.is_jumping = False
                self.vertical_speed = 0

    def jump(self):
        if not self.is_jumping and not hoverboard_active:
            self.is_jumping = True
            self.vertical_speed = self.JUMP_STRENGTH

    def move_lane(self, direction):
        new_index = self.current_lane_index + direction
        if 0 <= new_index < len(LANE_X_POSITIONS):
            self.current_lane_index = new_index
            self.rect.centerx = LANE_X_POSITIONS[self.current_lane_index]

# Obstacle, Coin, Diamond, Hoverboard classes are the same as before...
class Obstacle(pygame.sprite.Sprite):
    def __init__(self, lane_index):
        super().__init__(); obstacle_type = random.choice(['Barricade', 'Box'])
        if obstacle_type == 'Barricade': self.width, self.height, self.color = 80, 30, RED
        else: self.width, self.height, self.color = 40, 70, BROWN
        self.image = pygame.Surface([self.width, self.height]); self.image.fill(self.color); self.rect = self.image.get_rect(); self.rect.centerx = LANE_X_POSITIONS[lane_index]; self.rect.right = SCREEN_WIDTH + 50; self.rect.bottom = player.ground_y + 40 
    def update(self):
        self.rect.x -= GAME_SPEED; 
        if self.rect.right < 0: self.kill()

