# --- High Score File Management ---
def load_high_score():
    """Loads the high score from a file if it exists."""
    if os.path.exists("highscore.txt"):
        with open("highscore.txt", "r") as file:
            try:
                return int(file.read())
            except ValueError:
                return 0
    return 0

def save_high_score(score_value):
    """Saves the high score to a file."""
    with open("highscore.txt", "w") as file:
        file.write(str(score_value))

high_score = load_high_score()

# --- 3. Functions for Game State Management ---
def set_state(state):
    """Sets the global game state."""
    global GAME_STATE
    GAME_STATE = state

def start_game():
    """Initializes the game variables and sets state to RUNNING."""
    global score, game_over, hoverboard_active, hoverboard_timer, high_score
    
    # Check and save high score from the previous run
    if score // 10 > high_score:
        high_score = score // 10
        save_high_score(high_score)
        
    # Reset running session variables
    score = 0
    game_over = False
    hoverboard_active = False
    hoverboard_timer = 0
    
    # Re-initialize player and clear groups
    all_sprites.empty()
    obstacles.empty()
    coins.empty()
    diamonds_group.empty()
    hoverboards.empty()
    
    global player
    player = Player()
    all_sprites.add(player)
    
    # Reset timers
    pygame.time.set_timer(OBSTACLE_TIMER, random.randint(1500, 3000))
    set_coin_timer_with_rate()
    pygame.time.set_timer(DIAMOND_TIMER, random.randint(20000, 40000))
    pygame.time.set_timer(HOVERBOARD_TIMER, random.randint(15000, 30000))
    
    set_state('RUNNING')

def toggle_pause():
    """Toggles between RUNNING and PAUSED states."""
    if GAME_STATE == 'RUNNING':
        set_state('PAUSED')
    elif GAME_STATE == 'PAUSED':
        set_state('RUNNING')

# --- 4. Shop/Ability Actions (Moved to main scope for button access) ---
def buy_coin_upgrade():
    """Handles the purchase of the coin spawn rate upgrade."""
    global score, coin_spawn_upgrade_level, coin_spawn_rate_multiplier
    if coin_spawn_upgrade_level < MAX_COIN_UPGRADE_LEVEL:
        cost = UPGRADE_COSTS[coin_spawn_upgrade_level]
        internal_cost = cost * 10
        if score >= internal_cost:
            score -= internal_cost
            coin_spawn_upgrade_level += 1
            coin_spawn_rate_multiplier = UPGRADE_MULTIPLIERS[coin_spawn_upgrade_level - 1]
            set_coin_timer_with_rate()
        else:
            print("Not enough coins!")
    else:
        print("Max upgrade level reached!")

def buy_skin(skin_name):
    """Handles the purchase and equipping of a character skin."""
    global current_skin, diamonds, score
    price = SKIN_PRICES[skin_name]
    
    if skin_name == current_skin: return

    if skin_name in ["AD_SPIDER", "MINECRAFT"]:
        currency_amount = diamonds
        is_diamond_purchase = True
    else:
        currency_amount = score // 10 
        is_diamond_purchase = False

    if price == 0 or currency_amount >= price:
        if price > 0:
            if is_diamond_purchase:
                diamonds -= price
            else:
                score -= price * 10 

        current_skin = skin_name
        # Update player's color immediately if player exists
        if 'player' in globals():
             player.image.fill(SKIN_COLORS[current_skin])
    else:
        print(f"Not enough {'Diamonds' if is_diamond_purchase else 'Coins'}!")

def set_coin_timer_with_rate():
    """Sets the COIN_TIMER based on the current spawn rate multiplier."""
    min_ms = 5000 / coin_spawn_rate_multiplier
    max_ms = 10000 / coin_spawn_rate_multiplier
    pygame.time.set_timer(COIN_TIMER, 0) 
    pygame.time.set_timer(COIN_TIMER, int(random.uniform(min_ms, max_ms)))

# --- 5. Reusable Button Class ---
class Button():
    def __init__(self, x, y, width, height, text, color, action=None, font_size=24):
        self.rect = pygame.Rect(x, y, width, height)
        self.color = color
        self.text = text
        self.action = action
        self.font = pygame.font.Font(None, font_size)

    def draw(self, surface):
        pygame.draw.rect(surface, self.color, self.rect, border_radius=5)
        text_surface = self.font.render(self.text, True, BLACK)
        text_rect = text_surface.get_rect(center=self.rect.center)
        surface.blit(text_surface, text_rect)

    def check_click(self, event):
        if event.type == pygame.MOUSEBUTTONDOWN:
            if self.rect.collidepoint(event.pos):
                if self.action:
                    self.action()
                return True
        return False
        
